<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>de.symeda.sormas</groupId>
		<artifactId>sormas-base</artifactId>
 		<version>1.0.44</version>
		<relativePath>../sormas-base</relativePath>
	</parent>

	<properties>
		<sormasRest.apiRoot>/sormas-rest</sormasRest.apiRoot>
		    <maven.compiler.release>17</maven.compiler.release>

	</properties>

	<artifactId>sormas-rest</artifactId>
	<name>${project.artifactId}</name>
	<packaging>war</packaging>

	<dependencies>

		<dependency>
			<groupId>javax</groupId>
			<artifactId>javaee-web-api</artifactId>
		</dependency>

		<dependency>
			<groupId>com.opencsv</groupId>
			<artifactId>opencsv</artifactId>
		</dependency>

		<dependency>
			<groupId>org.slf4j</groupId>
			<artifactId>slf4j-api</artifactId>
		</dependency>

		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>sormas-api</artifactId>
			<version>${project.version}</version>
		</dependency>

		<dependency>
			<groupId>org.glassfish.jersey.containers</groupId>
			<artifactId>jersey-container-servlet</artifactId>
		</dependency>
		<dependency>
			<groupId>org.glassfish.jersey.media</groupId>
			<artifactId>jersey-media-json-jackson</artifactId>
		</dependency>

	  	<dependency>
			<groupId>javax.security.enterprise</groupId>
			<artifactId>javax.security.enterprise-api</artifactId>
		</dependency>

		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-jaxrs2</artifactId>
		</dependency>

		<dependency>
			<groupId>io.swagger.core.v3</groupId>
			<artifactId>swagger-jaxrs2-servlet-initializer-v2</artifactId>
		</dependency>

		<!-- Keycloak -->
		<dependency>
			<groupId>org.keycloak</groupId>
			<artifactId>keycloak-servlet-filter-adapter</artifactId>
		</dependency>

		<!-- OpenID -->
		<dependency>
			<groupId>fish.payara.api</groupId>
			<artifactId>payara-api</artifactId>
		</dependency>

		<dependency>
			<groupId>fish.payara.security.connectors</groupId>
			<artifactId>security-connector-oidc-client</artifactId>
		</dependency>

		<dependency>
			<groupId>org.eclipse.microprofile.config</groupId>
			<artifactId>microprofile-config-api</artifactId>
		</dependency>
		
		<dependency>
    		<groupId>com.vladmihalcea</groupId>
    		<artifactId>hibernate-types-52</artifactId>
    		<version>2.21.1</version> <!-- Use the latest compatible version -->
		</dependency>
		
		<dependency>
    <groupId>org.bouncycastle</groupId>
    <artifactId>bcprov-jdk18on</artifactId>
</dependency>

<dependency>
    <groupId>org.bouncycastle</groupId>
    <artifactId>bcpkix-jdk18on</artifactId>
</dependency>


<dependency>
    <groupId>jakarta.annotation</groupId>
    <artifactId>jakarta.annotation-api</artifactId>
    <scope>provided</scope>
</dependency>

	</dependencies>

	<build>
		<finalName>${project.artifactId}</finalName>

		<plugins>
			<!-- Provide WebApp context path via value of `sormasRest.apiRoot` property -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-war-plugin</artifactId>
				<configuration>
					<filteringDeploymentDescriptors>true</filteringDeploymentDescriptors>
					<webResources>
						<resource>
							<directory>src/main/webapp/META-INF</directory>
							<includes>
								<include>context.xml</include>
							</includes>
							<targetPath>/META-INF</targetPath>
							<filtering>true</filtering>
						</resource>
						<resource>
							<directory>src/main/webapp</directory>
							<targetPath>/</targetPath>
							<filtering>false</filtering>
						</resource>
					</webResources>
				</configuration>
			</plugin>


			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>properties-maven-plugin</artifactId>
				<version>1.2.1</version>
				<executions>
					<execution>
						<phase>initialize</phase>
						<goals>
							<goal>read-project-properties</goal>
						</goals>
						<configuration>
							<files>
								<file>src/main/resources/workflow-documentation.properties</file>
							</files>
						</configuration>
					</execution>
				</executions>
			</plugin>

			<!-- Swagger Generation -->
			<plugin>
				<groupId>io.swagger.core.v3</groupId>
				<artifactId>swagger-maven-plugin</artifactId>
				<version>2.2.31</version>

				
				<configuration>
					<!-- Swagger Generation Config -->
					<resourcePackages>
						<resourcePackage>de.symeda.sormas.rest</resourcePackage>
						<resourcePackage>de.symeda.sormas.rest.security</resourcePackage>
						<resourcePackage>de.symeda.sormas.rest.swagger</resourcePackage>
					</resourcePackages>
					<outputPath>${project.build.directory}</outputPath>
					<outputFileName>swagger</outputFileName>
					<prettyPrint>true</prettyPrint>
				</configuration>
				
				
				<executions>
					<execution>
						<id>generate-swagger-json</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>resolve</goal>
						</goals>
						<configuration>
							<outputFormat>JSON</outputFormat>
						</configuration>
					</execution>
					<execution>
						<id>generate-swagger-yaml</id>
						<phase>generate-resources</phase>
						<goals>
							<goal>resolve</goal>
						</goals>
						<configuration>
							<outputFormat>YAML</outputFormat>
						</configuration>
					</execution>
					<execution>
						<id>generate-swagger-for-journal-json</id>
						<phase>generate-test-resources</phase>
						<goals>
							<goal>resolve</goal>
						</goals>
						<configuration>
							<outputPath>${project.build.directory}</outputPath>
							<outputFileName>external_visits_API</outputFileName>
							<outputFormat>JSON</outputFormat>
							<resourcePackages>
								<resourcePackage>de.symeda.sormas.rest.externaljournal</resourcePackage>
							</resourcePackages>
						</configuration>
					</execution>
					<execution>
						<id>generate-swagger-for-journal-yaml</id>
						<phase>generate-test-resources</phase>
						<goals>
							<goal>resolve</goal>
						</goals>
						<configuration>
							<outputPath>${project.build.directory}</outputPath>
							<outputFileName>external_visits_API</outputFileName>
							<outputFormat>YAML</outputFormat>
							<resourcePackages>
								<resourcePackage>de.symeda.sormas.rest.externaljournal</resourcePackage>
							</resourcePackages>
						</configuration>
					</execution>
				</executions>
				
			</plugin>
		</plugins>
		<pluginManagement>
			<plugins>
				<!--This plugin's configuration is used to store Eclipse m2e settings only. It has no influence on the Maven build itself.-->
				<plugin>
					<groupId>org.eclipse.m2e</groupId>
					<artifactId>lifecycle-mapping</artifactId>
					<version>1.0.0</version>
					<configuration>
						<lifecycleMappingMetadata>
							<pluginExecutions>
								<pluginExecution>
									<pluginExecutionFilter>
										<groupId>
											io.swagger.core.v3
										</groupId>
										<artifactId>
											swagger-maven-plugin
										</artifactId>
										<versionRange>
											[2.2.31,)
										</versionRange>
										<goals>
											<goal>resolve</goal>
										</goals>
									</pluginExecutionFilter>
									<action>
										<ignore></ignore>
									</action>
								</pluginExecution>
							</pluginExecutions>
						</lifecycleMappingMetadata>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

</project>